# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Supabase Storage Buckets
NEXT_PUBLIC_STORAGE_BUCKET_BLOG=blog-bucket

# PostgreSQL connection
DATABASE_URL=YOUR_SUPABASE_POOLER_CONNECTION_STRING

# Direct connection (untuk migration)
DIRECT_URL=YOUR_SUPABASE_DIRECT_CONNECTION_STRING

# ==========================================
# EMAIL / SMTP CONFIGURATION
# ==========================================
# Untuk development lokal dengan Mailpit:
#   docker run -d -p 1025:1025 -p 8025:8025 --name mailpit axllent/mailpit
#   Akses Web UI Mailpit di: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Kemas Prasasti <noreply@kemasprasasti.com>"

